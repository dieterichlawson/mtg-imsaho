/target
*.txt
# Deck lists are data, not run output — track them despite *.txt above.
!/decks/**/*.txt
# The accepted-survivor list is reviewed reference data the weekly-mutants
# workflow compares against, not run output.
!/reports/mutants-accepted.txt
!/reports/mutants-backlog.txt
*.log
/results.json
# Nightly playtest run output (logs + --save snapshots): transient repro
# evidence for the night's issue filing, deleted once the report is
# written. Never committed — see docs/playtest/README.md.
/logs/playtest/
# cargo-mutants run output; survivors worth keeping get summarized into
# reports/, the raw outcomes live in the weekly-mutants CI artifacts.
mutants.out/
mutants.out.old/
/reports/coverage/
# Claude Code: commit commands/skills and project settings, ignore local/personal files
.claude/settings.local.json
.claude/worktrees/
.*.swp

# Python bytecode caches from scripts/
__pycache__/
*.pyc
