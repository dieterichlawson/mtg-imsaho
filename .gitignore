/target
*.txt
*.log
/results.json
/reports/coverage/
# Agent-produced staging markdown is ephemeral transport; validate
# scripts expect a clean worktree and ignore this directory.
/pipeline/staging/
# Raw agent event logs (written by run_agent_in); cleaned up on
# merge/abandon. Kept on disk for post-mortem during a run.
/pipeline/logs/
/new_pipeline/staging/
/new_pipeline/logs/
# Per-worktree cargo config written by `worktree.ensure` (holds a
# dummy ANTHROPIC_API_KEY so tests that .expect() it don't panic
# when running under the pipeline's scrubbed env).
.cargo/
# Claude Code: commit commands/skills and project settings, ignore local/personal files
.claude/settings.local.json
.claude/worktrees/
.*.swp

# Python bytecode caches from scripts/
__pycache__/
*.pyc
