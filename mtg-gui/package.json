{
  "name": "mtg-gui",
  "private": true,
  "description": "The pixel-art page for mtg-imsaho: TypeScript sources in src/, compiled to dist/ (committed, so the runner serves it from a bare checkout).",
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "smoke": "node tests/smoke.js",
    "widgets": "node tests/widgets.js",
    "twotabs": "node tests/twotabs.js",
    "clip": "node tests/clip.mjs",
    "target-labels": "node tests/target_labels.mjs",
    "auto-pass": "node tests/auto_pass.mjs",
    "without-ids": "node tests/without_ids.mjs",
    "stack-key": "node tests/stack_key.mjs",
    "field-fits": "node tests/field_fits.js"
  },
  "devDependencies": {
    "typescript": "^5.4"
  }
}
